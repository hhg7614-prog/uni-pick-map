NEWS_AI_ENABLED=false
NEWS_AI_PROVIDER=disabled
NEWS_AI_MODEL=
NEWS_AI_MAX_ITEMS=15
NEWS_AI_REQUEST_TIMEOUT_MS=30000
NEWS_AI_MAX_RETRIES=1

# The scheduler is off by default. It never runs when the site starts unless
# NEWS_SCHEDULE_ENABLED is explicitly set to true in a server environment.
NEWS_SCHEDULE_ENABLED=false
NEWS_SCHEDULE_CRON=0 */3 * * *
NEWS_SCHEDULE_TIMEZONE=Asia/Seoul
NEWS_RUN_ON_STARTUP=false
NEWS_PREVENT_OVERLAP=true
NEWS_TARGET_UNIVERSITIES=snu,yonsei,hanyang,korea,sungkyunkwan,kyunghee,chungang,hufs,konkuk,ewha
NEWS_COLLECTION_LIMIT_PER_SOURCE=3
NEWS_COLLECTION_LIMIT_PER_UNIVERSITY=6
NEWS_TOTAL_COLLECTION_LIMIT=60
NEWS_AI_MAX_ITEMS=20

OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── 뉴스 에이전트 (오전 09:30 / 오후 17:30 자동 수집) ───────────────
# NEWS_AGENT_ENABLED=false 이면 자동 실행되지 않습니다.
# 수동 1회 실행: npm run news:agent:once
NEWS_AGENT_ENABLED=false
NEWS_AGENT_CRON=30 9,17 * * *
NEWS_AGENT_TIMEZONE=Asia/Seoul
NEWS_AGENT_RUN_ON_STARTUP=false
NEWS_AGENT_CATCH_UP_MISSED_RUNS=false
NEWS_AGENT_PREVENT_OVERLAP=true
NEWS_AGENT_LIMIT_PER_SOURCE=5
NEWS_AGENT_LIMIT_TOTAL=100
