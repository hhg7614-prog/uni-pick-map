{
  "name": "uni-pick-map",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "node server/app.js",
    "test": "node --test",
    "news:agent": "node server/agent/scheduler.js",
    "news:agent:once": "node server/agent/once.js",
    "news:agent:status": "node server/agent/status.js",
    "news:agent:stop": "node server/agent/stop.js",
    "news:agent:six": "node server/agent/tools/run-multi-school-trial.js --university-ids=seoul-national-university-gwanak,yonsei-university-sinchon,korea-university-seoul,hanyang-university-seoul,ewha-womans-university,dongguk-university-seoul --limit-per-source=3",
    "news:agent:six:deploy": "node server/agent/tools/run-six-university-news-and-deploy.js",
    "news:onboard:production-batch": "node server/agent/onboarding/tools/run-production-onboarding-batch.js",
    "news:onboard:production-batch:status": "node server/agent/onboarding/tools/run-production-onboarding-batch.js --status",
    "news:onboard:production-batch:resume": "node server/agent/onboarding/tools/run-production-onboarding-batch.js --resume",
    "news:onboard:production-batch:test10": "node server/agent/onboarding/tools/run-production-onboarding-batch.js --test10",
    "news:onboard:metadata-row-integrity:test6": "node server/agent/onboarding/tools/run-metadata-row-integrity-test6.js"
  },
  "engines": {
    "node": ">=18"
  }
}
